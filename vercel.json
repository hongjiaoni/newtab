{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "landing/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },

    { "src": "/favicon.svg", "dest": "/landing/favicon.svg" },
    { "src": "/favicon.png", "dest": "/landing/favicon.png" },
    { "src": "/favicon.ico", "dest": "/landing/favicon.png" },
    { "src": "/apple-touch-icon.png", "dest": "/landing/favicon.png" },
    { "src": "/badge.svg", "dest": "/landing/badge.svg" },
    { "src": "/screenshot.png", "dest": "/landing/screenshot.png" },
    { "src": "/screenshot-light.png", "dest": "/landing/screenshot-light.png" },
    { "src": "/screenshot-dark.png", "dest": "/landing/screenshot-dark.png" },

    { "src": "/$", "dest": "/public/index.html" },
    { "src": "/landing/?$", "dest": "/landing/index.html" },
    { "src": "/landing/(.*)", "dest": "/landing/$1" },
    { "src": "/intro/?$", "dest": "/landing/index.html" },
    { "src": "/intro/(.*)", "dest": "/landing/$1" },
    { "src": "/app/?$", "dest": "/public/index.html" },

    { "src": "/pricing/?$", "dest": "/landing/index.html" },
    { "src": "/terms/?$", "dest": "/landing/terms/index.html" },
    { "src": "/privacy/?$", "dest": "/landing/privacy/index.html" },

    { "handle": "filesystem" },

    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
