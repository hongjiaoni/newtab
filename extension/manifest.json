{
  "manifest_version": 3,
  "name": "NewTab",
  "version": "1.0.0",
  "description": "A Liquid Glass new tab page — search, favicon shortcuts, wallpapers, a personal workspace, and cloud sync",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://newtab.online/*",
    "https://*.newtab.online/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.paddle.com; font-src 'self'; img-src 'self' https: data:; connect-src 'self' https://* wss://*"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NewTab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "key": ""
}
